# Plantilla de /etc/skyops.env  --  el archivo real NO va al repositorio.
#
#   sudo cp deploy/skyops.env.example /etc/skyops.env
#   sudo nano /etc/skyops.env
#   sudo chmod 600 /etc/skyops.env
#
# Clave de firma de los tokens. MINIMO 32 CARACTERES o la aplicacion no arranca.
# Generar una al azar:  openssl rand -base64 48
JWT_SECRET=cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres

DB_HOST=localhost
DB_NAME=skyops
DB_USER=skyops
DB_PASSWORD=cambiar-por-la-clave-real

CORS_ORIGIN=http://localhost
